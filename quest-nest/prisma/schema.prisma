// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  phone    String?
  fullname String?
  meta     Json?  @db.JsonB

  @@map("user")
}

model Store {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  @@map("store")
}
model Menu {
  id   Int    @id @default(autoincrement())
  name String
  products Product[]
  @@map("menu")
}

model Product {
  id          String   @id @default(uuid())
  menus      Menu[]
  @@map("product")
}
